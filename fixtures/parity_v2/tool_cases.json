    {
      "id": "list_schemas.success.shape",
      "tool": "list_schemas",
      "title": "Schema listing returns ordered row objects",
      "source": {
        "python": "src/postgres_mcp/server.py:93",
        "rust": "src/tools.rs:126"
      },
      "input": {},
      "normalization_profiles": {
        "python": "python_text_repr_rows",
        "rust": "rust_structured_json"
      },
      "python_expected": {
        "kind": "ok",
        "payload_shape": {
          "root": "array<object>",
          "required_keys": [
            "schema_name",
            "schema_owner",
            "schema_type"
          ]
        }
      },
      "rust_expected": {
        "kind": "ok",
        "payload_shape": {
          "root": "array<object>",
          "required_keys": [
            "schema_name",
            "schema_owner",
            "schema_type"
          ]
        }
      },
      "assertions": [
        "rows ordered by schema_type then schema_name",
        "no additional wrapping envelope after normalization"
      ],
      "comparison_mode": "equivalent",
      "known_difference_ids": [
        "kd-response-envelope"
      ]
    },
