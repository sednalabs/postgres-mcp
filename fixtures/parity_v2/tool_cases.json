    {
      "id": "explain_query.analyze_with_hypothetical_disallowed",
      "tool": "explain_query",
      "title": "Mutually exclusive analyze and hypothetical_indexes",
      "source": {
        "python": "src/postgres_mcp/server.py:319",
        "rust": "src/tools.rs:298"
      },
      "input": {
        "sql": "SELECT 1",
        "analyze": true,
        "hypothetical_indexes": [
          {
            "table": "public.users",
            "columns": [
              "id"
            ]
          }
        ]
      },
      "normalization_profiles": {
        "python": "python_text_plain",
        "rust": "rust_structured_json"
      },
      "python_expected": {
        "kind": "error",
        "error_text_exact": "Error: Cannot use analyze and hypothetical indexes together"
      },
      "rust_expected": {
        "kind": "error",
        "error_text_exact": "Cannot use analyze=true together with hypothetical_indexes"
      },
      "assertions": [
        "branch runs before DB EXPLAIN execution"
      ],
      "comparison_mode": "known_difference",
      "known_difference_ids": [
        "kd-error-envelope"
      ]
    },
